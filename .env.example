# ---- Supabase (public, safe for client bundle) ----
# These are the anon (public) values from your Supabase project.
# They are embedded in the frontend bundle and are safe to expose.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ---- Qloo API Key (SERVER-SIDE ONLY — never put this in .env) ----
# QLOO_API_KEY is NOT read from .env. It is stored as a Supabase Edge
# Function secret and read at runtime via Deno.env.get("QLOO_API_KEY").
# To set it:
#   supabase functions secrets set QLOO_API_KEY=your-qloo-api-key
# or via the Supabase Dashboard under Edge Functions > Secrets.
#
# Do NOT add it to this file or to .env. Do NOT prefix it with VITE_.
